# ============================================================
# Weather Analytics — Variáveis de Ambiente
# Copie este arquivo para .env na raiz e preencha os valores.
# NUNCA commite o .env real no repositório.
# ============================================================

# Oracle Database (credenciais de exemplo — ajuste para o seu RM/ambiente)
ORACLE_USER=RM000000          # ex.: RM571375
ORACLE_PASS=troque_sua_senha  # NUNCA commite a senha real

# Exemplo de DSN FIAP (substitua pelo fornecido em sala):
# "(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))"
ORACLE_DSN=oracle.fiap.com.br:1521/ORCL

# Cache do dashboard Streamlit (segundos; mínimo 5)
# DASHBOARD_CACHE_TTL=300