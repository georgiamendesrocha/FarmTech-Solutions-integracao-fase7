+
+
+def _worker(scenario, root):
+    os.chdir(root)
+    sys.path.insert(0, str(root))
+    os.environ.update(DB_PATH=str(root / "fixture.db"), FARMTECH_SIMULACAO="0", UMIDADE_LIMIAR="72.5")
